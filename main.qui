// The execution mode is a nested namespace: dnn.mode.fast() and
// dnn.mode.deterministic().
public import mode = "./mode.qui"

void all_reduce_sum<T: floating>(tensor<T>[] &values)
    neural.all_reduce_sum(&values)

tensor<float32> | error uniform_weights(int count, float bound, int seed)
    if count < 0
        return error("dnn.uniform_weights count must be nonnegative")
    if not math.is_finite(bound) or bound < 0.0
        return error("dnn.uniform_weights bound must be finite and nonnegative")
    tensor<float32> values = tensor.zeros<float32>([count])
    random.Generator generator = random.generator(seed = seed)
    for index in range(count)
        float unit = generator.float()
        values[index] = float32((unit * 2.0 - 1.0) * bound)
    return values

// A layer is a class whose constructor can fail: `dnn.Linear(128, 64)` fails
// fast on an invalid shape, `try dnn.Linear(128, 64)` propagates the error.
// Declare `dnn.Linear layer` and assign `weight` and `bias` to build a layer
// from tensors you supply.
class Linear
    neural.Parameter<float32> weight
    neural.Parameter<float32> bias

    Linear | error construct(int features_in, int features_out, int seed = 1)
        if features_in <= 0 or features_out <= 0
            return error("dnn.Linear requires positive input and output feature counts")
        if features_out > 9223372036854775807 / features_in
            return error("dnn.Linear dimensions are too large")
        int weight_count = features_out * features_in
        float bound = 1.0 / math.sqrt(float(features_in))
        tensor<float32> weight_values = try uniform_weights(
            weight_count, bound, seed
        )
        weight_values = weight_values.reshape([features_out, features_in])
        weight = neural.Parameter<float32>(value = weight_values)
        bias = neural.Parameter<float32>(
            value = tensor.zeros<float32>([features_out])
        )

    X forward<X>(X value)
        return neural.affine(value, weight, bias)

class Conv2D
    neural.Parameter<float32> weight
    neural.Parameter<float32> bias
    int step
    int border

    Conv2D | error construct(
        int channels_in,
        int channels_out,
        int kernel,
        int stride = 1,
        int padding = 0,
        int seed = 1
    )
        if channels_in <= 0 or channels_out <= 0
            return error("dnn.Conv2D requires positive input and output channel counts")
        if kernel <= 0
            return error("dnn.Conv2D kernel must be positive")
        if stride <= 0
            return error("dnn.Conv2D stride must be positive")
        if padding < 0
            return error("dnn.Conv2D padding must be nonnegative")
        if kernel > 9223372036854775807 / kernel
            return error("dnn.Conv2D dimensions are too large")
        int kernel_area = kernel * kernel
        if channels_in > 9223372036854775807 / kernel_area
            return error("dnn.Conv2D dimensions are too large")
        int fan_in = channels_in * kernel_area
        if channels_out > 9223372036854775807 / fan_in
            return error("dnn.Conv2D dimensions are too large")
        int weight_count = channels_out * fan_in
        float bound = 1.0 / math.sqrt(float(fan_in))
        tensor<float32> weight_values = try uniform_weights(
            weight_count, bound, seed
        )
        weight_values = weight_values.reshape(
            [channels_out, channels_in, kernel, kernel]
        )
        weight = neural.Parameter<float32>(value = weight_values)
        bias = neural.Parameter<float32>(
            value = tensor.zeros<float32>([channels_out])
        )
        step = stride
        border = padding

    X forward<X>(X value)
        return neural.convolve2d(value, weight, bias, step, border)

class BatchNorm
    neural.Parameter<float32> scale
    neural.Parameter<float32> bias
    neural.State<tensor<float32>> running_mean
    neural.State<tensor<float32>> running_variance
    float running_momentum
    float variance_epsilon

    BatchNorm | error construct(
        int features,
        float momentum = 0.1,
        float epsilon = 0.00001
    )
        if features <= 0
            return error("dnn.BatchNorm features must be positive")
        if not math.is_finite(momentum) or momentum < 0.0 or momentum >= 1.0
            return error("dnn.BatchNorm momentum must be finite and in [0, 1)")
        if not math.is_finite(epsilon) or epsilon <= 0.0
            return error("dnn.BatchNorm epsilon must be finite and positive")
        scale = neural.Parameter<float32>(
            value = tensor.ones<float32>([features])
        )
        bias = neural.Parameter<float32>(
            value = tensor.zeros<float32>([features])
        )
        running_mean = neural.State<tensor<float32>>(
            value = tensor.zeros<float32>([features])
        )
        running_variance = neural.State<tensor<float32>>(
            value = tensor.ones<float32>([features])
        )
        running_momentum = momentum
        variance_epsilon = epsilon

    neural<float32> forward(neural<float32> value)
        return neural.normalize(
            value, scale, bias, running_mean, running_variance,
            momentum = running_momentum, epsilon = variance_epsilon
        )

    tensor<float32> infer(tensor<float32> value)
        return neural.normalize_inference(
            value, scale, bias, running_mean, running_variance,
            epsilon = variance_epsilon
        )

class Dropout
    float drop_rate
    neural.State<uint64> rng

    Dropout | error construct(float rate, uint64 seed = uint64(0))
        if not math.is_finite(rate) or rate < 0.0 or rate >= 1.0
            return error("dnn.Dropout rate must be finite and in [0, 1)")
        drop_rate = rate
        rng = neural.State<uint64>(value = seed)

    neural<float32> forward(neural<float32> value)
        return neural.random_mask(value, rng, rate = drop_rate)

    tensor<float32> infer(tensor<float32> value)
        return value

X relu<X>(X value)
    return (value + neural.absolute(value)) / 2.0

X tanh<X>(X value)
    X lifted = (value - 20.0 + neural.absolute(value + 20.0)) / 2.0
    X limited = (lifted + 20.0 - neural.absolute(lifted - 20.0)) / 2.0
    X exponent = neural.exponential(limited * 2.0)
    return (exponent - 1.0) / (exponent + 1.0)

X sigmoid<X>(X value)
    return (tanh<X>(value * 0.5) + 1.0) * 0.5

X softmax<X>(X value)
    X shifted = value - neural.max_last(value)
    X weights = neural.exponential(shifted)
    return weights / neural.sum_last(weights)

X gelu<X>(X value)
    X cubic = value * value * value
    X inner = (value + cubic * float32(0.044715)) * float32(0.7978845608028654)
    return value * 0.5 * (1.0 + tanh<X>(inner))

neural<float32> mse(neural<float32> prediction, tensor<float32> target)
    neural<float32> difference = prediction - neural.track(target)
    return neural.mean(difference * difference)

neural<float32> binary_cross_entropy(
    neural<float32> prediction,
    tensor<float32> target
)
    neural<float32> expected = neural.track(target)
    neural<float32> lifted = (
        prediction + float32(0.000001)
        + neural.absolute(prediction - float32(0.000001))
    ) / 2.0
    neural<float32> limited = (
        lifted + float32(0.999999)
        - neural.absolute(lifted - float32(0.999999))
    ) / 2.0
    neural<float32> first = expected * neural.logarithm(limited)
    neural<float32> second = (1.0 - expected) * neural.logarithm(1.0 - limited)
    return neural.mean(0.0 - first - second)

neural<float32> binary_cross_entropy_with_logits(
    neural<float32> logits,
    tensor<float32> target
)
    neural<float32> expected = neural.track(target)
    neural<float32> magnitude = neural.absolute(logits)
    neural<float32> positive = (logits + magnitude) / 2.0
    neural<float32> tail = neural.logarithm(
        1.0 + neural.exponential(0.0 - magnitude)
    )
    return neural.mean(positive - logits * expected + tail)

neural<float32> cross_entropy(
    neural<float32> logits,
    tensor<float32> target
)
    neural<float32> shifted = logits - neural.max_last(logits)
    neural<float32> total = neural.sum_last(neural.exponential(shifted))
    neural<float32> log_probabilities = shifted - neural.logarithm(total)
    neural<float32> expected = neural.track(target)
    neural<float32> per_class = expected * log_probabilities
    return neural.mean(0.0 - neural.sum_last(per_class))

class SGD
    float learning_rate

    SGD | error construct(float rate = 0.01)
        if not math.is_finite(rate) or rate <= 0.0
            return error("dnn.SGD rate must be finite and positive")
        learning_rate = rate

    void step<M>(M &model, neural.Gradients gradients)
        neural.update(&model, gradients, rate = learning_rate)

class Adam
    float learning_rate
    float first_decay
    float second_decay
    float stability
    private neural.State<int> iteration
    private neural.State<bin> moments

    Adam | error construct(
        float rate = 0.001,
        float beta1 = 0.9,
        float beta2 = 0.999,
        float epsilon = 0.00000001
    )
        if not math.is_finite(rate) or rate <= 0.0
            return error("dnn.Adam rate must be finite and positive")
        if not math.is_finite(beta1) or beta1 < 0.0 or beta1 >= 1.0
            return error("dnn.Adam beta1 must be finite and in [0, 1)")
        if not math.is_finite(beta2) or beta2 < 0.0 or beta2 >= 1.0
            return error("dnn.Adam beta2 must be finite and in [0, 1)")
        if not math.is_finite(epsilon) or epsilon <= 0.0
            return error("dnn.Adam epsilon must be finite and positive")
        learning_rate = rate
        first_decay = beta1
        second_decay = beta2
        stability = epsilon
        iteration = neural.State<int>(value = 0)
        moments = neural.State<bin>(value = bin.fill(0, 0))

    void step<M>(M &model, neural.Gradients gradients)
        neural.moment_update(
            &model,
            learning_rate,
            first_decay,
            second_decay,
            stability,
            &iteration,
            &moments,
            gradients
        )
