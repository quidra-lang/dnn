class model.ResNetStem
    nn.Conv2D conv
    nn.BatchNorm norm

    model.ResNetStem | error construct(int seed = 1)
        conv = try nn.normal_conv2d(
            3, 64, 7, try math.sqrt(real64(2.0 / 147.0)),
            stride = 2, padding = 3, seed = seed
        )
        norm = try nn.BatchNorm(64)

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> output = nn.relu(norm.forward(conv.forward(value)))
        return nn.max_pool2d(output, 3, 2, padding = 1)

    tensor<real32> infer(tensor<real32> value)
        tensor<real32> output = nn.relu(norm.infer(conv.forward(value)))
        return nn.max_pool2d(output, 3, 2, padding = 1)

class model.ResNetBasicBlock
    nn.Conv2D conv1
    nn.BatchNorm norm1
    nn.Conv2D conv2
    nn.BatchNorm norm2

    model.ResNetBasicBlock | error construct(int channels, int seed = 1)
        conv1 = try nn.normal_conv2d(
            channels, channels, 3,
            try math.sqrt(2.0 / real64(channels * 9)),
            padding = 1, seed = seed
        )
        norm1 = try nn.BatchNorm(channels)
        conv2 = try nn.normal_conv2d(
            channels, channels, 3,
            try math.sqrt(2.0 / real64(channels * 9)),
            padding = 1, seed = seed + 1
        )
        norm2 = try nn.BatchNorm(channels)

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> residual = nn.relu(norm1.forward(conv1.forward(value)))
        residual = norm2.forward(conv2.forward(residual))
        return nn.relu(residual + value)

    tensor<real32> infer(tensor<real32> value)
        tensor<real32> residual = nn.relu(norm1.infer(conv1.forward(value)))
        residual = norm2.infer(conv2.forward(residual))
        return nn.relu(residual + value)

class model.ResNetBottleneckBlock
    nn.Conv2D conv1
    nn.BatchNorm norm1
    nn.Conv2D conv2
    nn.BatchNorm norm2
    nn.Conv2D conv3
    nn.BatchNorm norm3

    model.ResNetBottleneckBlock | error construct(
        int channels,
        int bottleneck,
        int seed = 1
    )
        conv1 = try nn.normal_conv2d(
            channels, bottleneck, 1,
            try math.sqrt(2.0 / real64(channels)),
            seed = seed
        )
        norm1 = try nn.BatchNorm(bottleneck)
        conv2 = try nn.normal_conv2d(
            bottleneck, bottleneck, 3,
            try math.sqrt(2.0 / real64(bottleneck * 9)),
            padding = 1, seed = seed + 1
        )
        norm2 = try nn.BatchNorm(bottleneck)
        conv3 = try nn.normal_conv2d(
            bottleneck, channels, 1,
            try math.sqrt(2.0 / real64(bottleneck)),
            seed = seed + 2
        )
        norm3 = try nn.BatchNorm(channels)

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> residual = nn.relu(norm1.forward(conv1.forward(value)))
        residual = nn.relu(norm2.forward(conv2.forward(residual)))
        residual = norm3.forward(conv3.forward(residual))
        return nn.relu(residual + value)

    tensor<real32> infer(tensor<real32> value)
        tensor<real32> residual = nn.relu(norm1.infer(conv1.forward(value)))
        residual = nn.relu(norm2.infer(conv2.forward(residual)))
        residual = norm3.infer(conv3.forward(residual))
        return nn.relu(residual + value)

class model.ResNetBottleneckProjectionBlock
    nn.Conv2D conv1
    nn.BatchNorm norm1
    nn.Conv2D conv2
    nn.BatchNorm norm2
    nn.Conv2D conv3
    nn.BatchNorm norm3
    nn.Conv2D shortcut
    nn.BatchNorm shortcut_norm

    model.ResNetBottleneckProjectionBlock | error construct(
        int channels_in,
        int bottleneck,
        int channels_out,
        int stride,
        int seed = 1
    )
        // Original ResNet-v1 places the stage-changing stride in the first
        // 1x1 bottleneck convolution (not the later "v1.5" 3x3 placement).
        conv1 = try nn.normal_conv2d(
            channels_in, bottleneck, 1,
            try math.sqrt(2.0 / real64(channels_in)),
            stride = stride, seed = seed
        )
        norm1 = try nn.BatchNorm(bottleneck)
        conv2 = try nn.normal_conv2d(
            bottleneck, bottleneck, 3,
            try math.sqrt(2.0 / real64(bottleneck * 9)),
            padding = 1, seed = seed + 1
        )
        norm2 = try nn.BatchNorm(bottleneck)
        conv3 = try nn.normal_conv2d(
            bottleneck, channels_out, 1,
            try math.sqrt(2.0 / real64(bottleneck)),
            seed = seed + 2
        )
        norm3 = try nn.BatchNorm(channels_out)
        shortcut = try nn.normal_conv2d(
            channels_in, channels_out, 1,
            try math.sqrt(2.0 / real64(channels_in)),
            stride = stride, seed = seed + 3
        )
        shortcut_norm = try nn.BatchNorm(channels_out)

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> residual = nn.relu(norm1.forward(conv1.forward(value)))
        residual = nn.relu(norm2.forward(conv2.forward(residual)))
        residual = norm3.forward(conv3.forward(residual))
        tensor<real32> identity = shortcut_norm.forward(shortcut.forward(value))
        return nn.relu(residual + identity)

    tensor<real32> infer(tensor<real32> value)
        tensor<real32> residual = nn.relu(norm1.infer(conv1.forward(value)))
        residual = nn.relu(norm2.infer(conv2.forward(residual)))
        residual = norm3.infer(conv3.forward(residual))
        tensor<real32> identity = shortcut_norm.infer(shortcut.forward(value))
        return nn.relu(residual + identity)

class model.ResNetBasicIdentityStage
    model.ResNetBasicBlock[] blocks

    model.ResNetBasicIdentityStage | error construct(
        int channels,
        int count,
        int seed = 1
    )
        if count <= 0
            return error("ResNet basic identity stage requires a positive block count")
        blocks = []
        for index in range(count)
            blocks = blocks.append(
                try model.ResNetBasicBlock(channels, seed + index * 2)
            )

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> output = value
        for block in blocks
            output = block.forward(output)
        return output

    tensor<real32> infer(tensor<real32> value)
        tensor<real32> output = value
        for block in blocks
            output = block.infer(output)
        return output



class model.ResNetBasicOptionABlock
    nn.Conv2D conv1
    nn.BatchNorm norm1
    nn.Conv2D conv2
    nn.BatchNorm norm2
    int output_channels
    int shortcut_stride

    model.ResNetBasicOptionABlock | error construct(
        int channels_in,
        int channels_out,
        int stride,
        int seed = 1
    )
        conv1 = try nn.normal_conv2d(
            channels_in, channels_out, 3,
            try math.sqrt(2.0 / real64(channels_in * 9)),
            stride = stride, padding = 1, seed = seed
        )
        norm1 = try nn.BatchNorm(channels_out)
        conv2 = try nn.normal_conv2d(
            channels_out, channels_out, 3,
            try math.sqrt(2.0 / real64(channels_out * 9)),
            padding = 1, seed = seed + 1
        )
        norm2 = try nn.BatchNorm(channels_out)
        output_channels = channels_out
        shortcut_stride = stride

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> residual = nn.relu(
            norm1.forward(conv1.forward(value))
        )
        residual = norm2.forward(conv2.forward(residual))
        tensor<real32> identity = internal.resnet_option_a_shortcut(
            value, output_channels, shortcut_stride
        )
        return nn.relu(residual + identity)

    tensor<real32> infer(tensor<real32> value)
        tensor<real32> residual = nn.relu(
            norm1.infer(conv1.forward(value))
        )
        residual = norm2.infer(conv2.forward(residual))
        tensor<real32> identity = internal.resnet_option_a_shortcut(
            value, output_channels, shortcut_stride
        )
        return nn.relu(residual + identity)

class model.ResNetBasicOptionAStage
    model.ResNetBasicOptionABlock first
    model.ResNetBasicBlock[] blocks

    model.ResNetBasicOptionAStage | error construct(
        int channels_in,
        int channels_out,
        int count,
        int seed = 1
    )
        if count <= 0
            return error("ResNet basic option-A stage requires a positive block count")
        first = try model.ResNetBasicOptionABlock(
            channels_in, channels_out, 2, seed
        )
        blocks = []
        for index in range(count - 1)
            blocks = blocks.append(
                try model.ResNetBasicBlock(
                    channels_out, seed + 2 + index * 2
                )
            )

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> output = first.forward(value)
        for block in blocks
            output = block.forward(output)
        return output

    tensor<real32> infer(tensor<real32> value)
        tensor<real32> output = first.infer(value)
        for block in blocks
            output = block.infer(output)
        return output

class model.ResNetBottleneckStage
    model.ResNetBottleneckProjectionBlock first
    model.ResNetBottleneckBlock[] blocks

    model.ResNetBottleneckStage | error construct(
        int channels_in,
        int bottleneck,
        int channels_out,
        int count,
        int stride,
        int seed = 1
    )
        if count <= 0
            return error("ResNet bottleneck stage requires a positive block count")
        first = try model.ResNetBottleneckProjectionBlock(
            channels_in, bottleneck, channels_out, stride, seed
        )
        blocks = []
        for index in range(count - 1)
            blocks = blocks.append(
                try model.ResNetBottleneckBlock(
                    channels_out, bottleneck, seed + 4 + index * 3
                )
            )

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> output = first.forward(value)
        for block in blocks
            output = block.forward(output)
        return output

    tensor<real32> infer(tensor<real32> value)
        tensor<real32> output = first.infer(value)
        for block in blocks
            output = block.infer(output)
        return output

class model.ResNet18
    model.ResNetStem stem
    model.ResNetBasicIdentityStage conv2_x
    model.ResNetBasicOptionAStage conv3_x
    model.ResNetBasicOptionAStage conv4_x
    model.ResNetBasicOptionAStage conv5_x
    nn.FC fc

    model.ResNet18 | error construct(int seed = 1)
        stem = try model.ResNetStem(seed)
        conv2_x = try model.ResNetBasicIdentityStage(64, 2, seed + 10)
        conv3_x = try model.ResNetBasicOptionAStage(64, 128, 2, seed + 30)
        conv4_x = try model.ResNetBasicOptionAStage(128, 256, 2, seed + 60)
        conv5_x = try model.ResNetBasicOptionAStage(256, 512, 2, seed + 100)
        fc = try nn.normal_fc(
            512, 1000, try math.sqrt(real64(2.0 / 512.0)),
            seed = seed + 140
        )

    tensor<real32> forward(tensor<real32> value)
        internal.require_imagenet_input(value, 224)
        tensor<real32> output = stem.forward(value)
        output = conv2_x.forward(output)
        output = conv3_x.forward(output)
        output = conv4_x.forward(output)
        output = conv5_x.forward(output)
        return fc.forward(nn.global_average_pool2d(output))

    tensor<real32> infer(tensor<real32> value)
        internal.require_imagenet_input(value, 224)
        tensor<real32> output = stem.infer(value)
        output = conv2_x.infer(output)
        output = conv3_x.infer(output)
        output = conv4_x.infer(output)
        output = conv5_x.infer(output)
        return fc.forward(nn.global_average_pool2d(output))

    tensor<real32> probabilities(tensor<real32> value)
        return nn.softmax(infer(value))

