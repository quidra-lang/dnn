class SGD
    float learning_rate
    private int iteration

    SGD | error construct(float rate = 0.01)
        if not math.is_finite(rate) or rate <= 0.0
            return error("dnn.SGD rate must be finite and positive")
        learning_rate = rate
        iteration = 0

    void zero_grad<M>(M &model)
        Parameter<float32>[] parameters32 = reflect.collect<Parameter<float32>>(model)
        for parameter in parameters32
            parameter.clear_grad()
        Parameter<float>[] parameters64 = reflect.collect<Parameter<float>>(model)
        for parameter in parameters64
            parameter.clear_grad()

    void step<M>(M &model)
        iteration = iteration + int(1)
        Parameter<float32>[] parameters32 = reflect.collect<Parameter<float32>>(model)
        float32 rate32 = float32(learning_rate)
        for parameter in parameters32
            if parameter.has_grad()
                tensor<float32> gradient = parameter.gradient().untrack()
                parameter.replace(parameter.raw() - gradient * rate32)

        Parameter<float>[] parameters64 = reflect.collect<Parameter<float>>(model)
        for parameter in parameters64
            if parameter.has_grad()
                tensor<float> gradient = parameter.gradient().untrack()
                parameter.replace(parameter.raw() - gradient * learning_rate)

class Adam
    float learning_rate
    float first_decay
    float second_decay
    float stability
    private int iteration
    private Parameter<float32>[] bound32
    private tensor<float32>[] first32
    private tensor<float32>[] second32
    private Parameter<float>[] bound64
    private tensor<float>[] first64
    private tensor<float>[] second64

    Adam | error construct(
        float rate = 0.001,
        float beta1 = 0.9,
        float beta2 = 0.999,
        float epsilon = 0.00000001
    )
        if not math.is_finite(rate) or rate <= 0.0
            return error("dnn.Adam rate must be finite and positive")
        if not math.is_finite(beta1) or beta1 < 0.0 or beta1 >= 1.0
            return error("dnn.Adam beta1 must be finite and in [0, 1)")
        if not math.is_finite(beta2) or beta2 < 0.0 or beta2 >= 1.0
            return error("dnn.Adam beta2 must be finite and in [0, 1)")
        if not math.is_finite(epsilon) or epsilon <= 0.0
            return error("dnn.Adam epsilon must be finite and positive")
        learning_rate = rate
        first_decay = beta1
        second_decay = beta2
        stability = epsilon
        iteration = 0
        bound32 = []
        first32 = []
        second32 = []
        bound64 = []
        first64 = []
        second64 = []

    void | error save(string path)
        file.Handle output = try file.create(path)
        try output.write_line("QUIDRA_DNN_ADAM_V1")
        try output.write_line(learning_rate.string())
        try output.write_line(first_decay.string())
        try output.write_line(second_decay.string())
        try output.write_line(stability.string())
        try output.write_line(iteration.string())
        try output.write_line(len(first32).string())
        try output.write_line(len(first64).string())
        for value in first32
            try internal.write_state_tensor(&output, value)
        for value in second32
            try internal.write_state_tensor(&output, value)
        for value in first64
            try internal.write_state_tensor(&output, value)
        for value in second64
            try internal.write_state_tensor(&output, value)
        try output.flush()
        return

    void | error load<M>(M &model, string path)
        file.Handle input = try file.open(path)
        string | none | error magic_line = input.read_line()
        string magic
        match magic_line
            string
                magic = magic_line
            none
                return error("dnn.Adam.load state file is empty")
            error problem
                return problem
        if magic != "QUIDRA_DNN_ADAM_V1"
            return error("dnn.Adam.load state file has an unsupported format")

        string[] header = []
        for index in range(7)
            string | none | error line = input.read_line()
            match line
                string
                    header = header.append(line)
                none
                    return error("dnn.Adam.load state header is incomplete")
                error problem
                    return problem

        float loaded_learning_rate = try float.parse(header[0])
        float loaded_first_decay = try float.parse(header[1])
        float loaded_second_decay = try float.parse(header[2])
        float loaded_stability = try float.parse(header[3])
        int loaded_iteration = try int.parse(header[4])
        int count32 = try int.parse(header[5])
        int count64 = try int.parse(header[6])
        if loaded_iteration < 0 or count32 < 0 or count64 < 0
            return error("dnn.Adam.load state header contains an invalid count")
        if not math.is_finite(loaded_learning_rate) or loaded_learning_rate <= 0.0
            return error("dnn.Adam.load learning rate must be finite and positive")
        if not math.is_finite(loaded_first_decay) or loaded_first_decay < 0.0 or loaded_first_decay >= 1.0
            return error("dnn.Adam.load beta1 must be finite and in [0, 1)")
        if not math.is_finite(loaded_second_decay) or loaded_second_decay < 0.0 or loaded_second_decay >= 1.0
            return error("dnn.Adam.load beta2 must be finite and in [0, 1)")
        if not math.is_finite(loaded_stability) or loaded_stability <= 0.0
            return error("dnn.Adam.load epsilon must be finite and positive")

        Parameter<float32>[] parameters32 = reflect.collect<Parameter<float32>>(model)
        Parameter<float>[] parameters64 = reflect.collect<Parameter<float>>(model)
        if count32 != len(parameters32) or count64 != len(parameters64)
            return error("dnn.Adam.load parameter binding does not match the target model")

        tensor<float32>[] loaded_first32 = []
        tensor<float32>[] loaded_second32 = []
        tensor<float>[] loaded_first64 = []
        tensor<float>[] loaded_second64 = []
        for parameter in parameters32
            tensor<float32> first = try internal.read_state_tensor32(&input)
            if first.shape() != parameter.raw().shape()
                return error("dnn.Adam.load first moment shape does not match")
            loaded_first32 = loaded_first32.append(first)
        for parameter in parameters32
            tensor<float32> second = try internal.read_state_tensor32(&input)
            if second.shape() != parameter.raw().shape()
                return error("dnn.Adam.load second moment shape does not match")
            loaded_second32 = loaded_second32.append(second)
        for parameter in parameters64
            tensor<float> first = try internal.read_state_tensor64(&input)
            if first.shape() != parameter.raw().shape()
                return error("dnn.Adam.load first moment shape does not match")
            loaded_first64 = loaded_first64.append(first)
        for parameter in parameters64
            tensor<float> second = try internal.read_state_tensor64(&input)
            if second.shape() != parameter.raw().shape()
                return error("dnn.Adam.load second moment shape does not match")
            loaded_second64 = loaded_second64.append(second)

        string | none | error trailing = input.read_line()
        match trailing
            string
                return error("dnn.Adam.load state file contains trailing data")
            none
                int complete = 0
            error problem
                return problem

        learning_rate = loaded_learning_rate
        first_decay = loaded_first_decay
        second_decay = loaded_second_decay
        stability = loaded_stability
        iteration = loaded_iteration
        bound32 = parameters32
        first32 = loaded_first32
        second32 = loaded_second32
        bound64 = parameters64
        first64 = loaded_first64
        second64 = loaded_second64
        return

    void zero_grad<M>(M &model)
        Parameter<float32>[] parameters32 = reflect.collect<Parameter<float32>>(model)
        for parameter in parameters32
            parameter.clear_grad()
        Parameter<float>[] parameters64 = reflect.collect<Parameter<float>>(model)
        for parameter in parameters64
            parameter.clear_grad()

    void step<M>(M &model)
        Parameter<float32>[] parameters32 = reflect.collect<Parameter<float32>>(model)
        Parameter<float>[] parameters64 = reflect.collect<Parameter<float>>(model)

        bool changed = len(parameters32) != len(bound32) or len(parameters64) != len(bound64)
        if not changed
            for index in range(len(parameters32))
                if not parameters32[index].same(bound32[index])
                    changed = true
            for index in range(len(parameters64))
                if not parameters64[index].same(bound64[index])
                    changed = true

        if changed
            bound32 = parameters32
            first32 = []
            second32 = []
            for parameter in parameters32
                tensor<float32> zero = parameter.raw() * float32(0)
                first32 = first32.append(zero)
                second32 = second32.append(zero)

            bound64 = parameters64
            first64 = []
            second64 = []
            for parameter in parameters64
                tensor<float> zero = parameter.raw() * 0.0
                first64 = first64.append(zero)
                second64 = second64.append(zero)
            iteration = 0

        if len(parameters32) > 0 or len(parameters64) > 0
            iteration = iteration + int(1)
            float correction1 = 1.0 - math.pow(first_decay, float(iteration))
            float correction2 = 1.0 - math.pow(second_decay, float(iteration))

            float32 beta1_32 = float32(first_decay)
            float32 beta2_32 = float32(second_decay)
            float32 one_minus_beta1_32 = float32(1.0 - first_decay)
            float32 one_minus_beta2_32 = float32(1.0 - second_decay)
            float32 correction1_32 = float32(correction1)
            float32 correction2_32 = float32(correction2)
            float32 epsilon32 = float32(stability)
            float32 rate32 = float32(learning_rate)
            for index in range(len(parameters32))
                Parameter<float32> parameter = parameters32[index]
                if parameter.has_grad()
                    tensor<float32> gradient = parameter.gradient().untrack()
                    tensor<float32> first = (
                        first32[index] * beta1_32
                        + gradient * one_minus_beta1_32
                    )
                    tensor<float32> second = (
                        second32[index] * beta2_32
                        + gradient * gradient * one_minus_beta2_32
                    )
                    tensor<float32> first_hat = first / correction1_32
                    tensor<float32> second_hat = second / correction2_32
                    tensor<float32> denominator = (
                        second_hat.log() * float32(0.5)
                    ).exp() + epsilon32
                    parameter.replace(
                        parameter.raw() - (first_hat / denominator) * rate32
                    )
                    first32[index] = first
                    second32[index] = second

            float one_minus_beta1 = 1.0 - first_decay
            float one_minus_beta2 = 1.0 - second_decay
            for index in range(len(parameters64))
                Parameter<float> parameter = parameters64[index]
                if parameter.has_grad()
                    tensor<float> gradient = parameter.gradient().untrack()
                    tensor<float> first = (
                        first64[index] * first_decay
                        + gradient * one_minus_beta1
                    )
                    tensor<float> second = (
                        second64[index] * second_decay
                        + gradient * gradient * one_minus_beta2
                    )
                    tensor<float> first_hat = first / correction1
                    tensor<float> second_hat = second / correction2
                    tensor<float> denominator = (
                        second_hat.log() * 0.5
                    ).exp() + stability
                    parameter.replace(
                        parameter.raw() - (first_hat / denominator) * learning_rate
                    )
                    first64[index] = first
                    second64[index] = second
