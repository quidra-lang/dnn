class model.VGGB
    model.VGGBlock2 block1
    model.VGGBlock2 block2
    model.VGGBlock2 block3
    model.VGGBlock2 block4
    model.VGGBlock2 block5
    model.ImageNetFC4096 classifier

    model.VGGB | error construct(int seed = 1)
        block1 = try model.VGGBlock2(3, 64, seed + 0)
        block2 = try model.VGGBlock2(64, 128, seed + 2)
        block3 = try model.VGGBlock2(128, 256, seed + 4)
        block4 = try model.VGGBlock2(256, 512, seed + 6)
        block5 = try model.VGGBlock2(512, 512, seed + 8)
        classifier = try model.ImageNetFC4096(
            25088, seed + 10,
            weight_standard_deviation = try math.sqrt(real64(0.01)),
            hidden_bias = 0.0
        )

    void initialize_from(model.VGGA source)
        // Net A supplies the four convolution layers with matching
        // stage/shape positions and the three fully-connected layers.
        // All extra layers keep their paper-specified random initialization.
        block1.conv1.weight.replace(source.block1.conv1.weight.raw())
        block1.conv1.bias.replace(source.block1.conv1.bias.raw())
        block2.conv1.weight.replace(source.block2.conv1.weight.raw())
        block2.conv1.bias.replace(source.block2.conv1.bias.raw())
        block3.conv1.weight.replace(source.block3.conv1.weight.raw())
        block3.conv1.bias.replace(source.block3.conv1.bias.raw())
        block3.conv2.weight.replace(source.block3.conv2.weight.raw())
        block3.conv2.bias.replace(source.block3.conv2.bias.raw())
        classifier.fc1.weight.replace(source.classifier.fc1.weight.raw())
        classifier.fc1.bias.replace(source.classifier.fc1.bias.raw())
        classifier.fc2.weight.replace(source.classifier.fc2.weight.raw())
        classifier.fc2.bias.replace(source.classifier.fc2.bias.raw())
        classifier.fc3.weight.replace(source.classifier.fc3.weight.raw())
        classifier.fc3.bias.replace(source.classifier.fc3.bias.raw())

    private tensor<real32> features(tensor<real32> value)
        internal.require_imagenet_input(value, 224)
        tensor<real32> output = block1.forward(value)
        output = nn.max_pool2d(output, 2, 2)
        output = block2.forward(output)
        output = nn.max_pool2d(output, 2, 2)
        output = block3.forward(output)
        output = nn.max_pool2d(output, 2, 2)
        output = block4.forward(output)
        output = nn.max_pool2d(output, 2, 2)
        output = block5.forward(output)
        output = nn.max_pool2d(output, 2, 2)
        return output.reshape([value.shape()[0], 25088])

    tensor<real32> forward(tensor<real32> value)
        return classifier.forward(features(value))

    tensor<real32> infer(tensor<real32> value)
        return classifier.infer(features(value))

    tensor<real32> probabilities(tensor<real32> value)
        return nn.softmax(infer(value))

