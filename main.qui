class model.ResNetStem
    Conv2D conv
    BatchNorm norm

    model.ResNetStem | error construct(int seed = 1)
        conv = try normal_conv2d(
            3, 64, 7, math.sqrt(2.0 / 147.0),
            stride = 2, padding = 3, seed = seed
        )
        norm = try BatchNorm(64)

    tensor<float32> forward(tensor<float32> value)
        tensor<float32> output = relu(norm.forward(conv.forward(value)))
        return max_pool2d(output, 3, 2, padding = 1)

    tensor<float32> infer(tensor<float32> value)
        tensor<float32> output = relu(norm.infer(conv.forward(value)))
        return max_pool2d(output, 3, 2, padding = 1)

class model.ResNetBasicBlock
    Conv2D conv1
    BatchNorm norm1
    Conv2D conv2
    BatchNorm norm2

    model.ResNetBasicBlock | error construct(int channels, int seed = 1)
        conv1 = try normal_conv2d(
            channels, channels, 3,
            math.sqrt(2.0 / float(channels * 9)),
            padding = 1, seed = seed
        )
        norm1 = try BatchNorm(channels)
        conv2 = try normal_conv2d(
            channels, channels, 3,
            math.sqrt(2.0 / float(channels * 9)),
            padding = 1, seed = seed + 1
        )
        norm2 = try BatchNorm(channels)

    tensor<float32> forward(tensor<float32> value)
        tensor<float32> residual = relu(norm1.forward(conv1.forward(value)))
        residual = norm2.forward(conv2.forward(residual))
        return relu(residual + value)

    tensor<float32> infer(tensor<float32> value)
        tensor<float32> residual = relu(norm1.infer(conv1.forward(value)))
        residual = norm2.infer(conv2.forward(residual))
        return relu(residual + value)

class model.ResNetBottleneckBlock
    Conv2D conv1
    BatchNorm norm1
    Conv2D conv2
    BatchNorm norm2
    Conv2D conv3
    BatchNorm norm3

    model.ResNetBottleneckBlock | error construct(
        int channels,
        int bottleneck,
        int seed = 1
    )
        conv1 = try normal_conv2d(
            channels, bottleneck, 1,
            math.sqrt(2.0 / float(channels)),
            seed = seed
        )
        norm1 = try BatchNorm(bottleneck)
        conv2 = try normal_conv2d(
            bottleneck, bottleneck, 3,
            math.sqrt(2.0 / float(bottleneck * 9)),
            padding = 1, seed = seed + 1
        )
        norm2 = try BatchNorm(bottleneck)
        conv3 = try normal_conv2d(
            bottleneck, channels, 1,
            math.sqrt(2.0 / float(bottleneck)),
            seed = seed + 2
        )
        norm3 = try BatchNorm(channels)

    tensor<float32> forward(tensor<float32> value)
        tensor<float32> residual = relu(norm1.forward(conv1.forward(value)))
        residual = relu(norm2.forward(conv2.forward(residual)))
        residual = norm3.forward(conv3.forward(residual))
        return relu(residual + value)

    tensor<float32> infer(tensor<float32> value)
        tensor<float32> residual = relu(norm1.infer(conv1.forward(value)))
        residual = relu(norm2.infer(conv2.forward(residual)))
        residual = norm3.infer(conv3.forward(residual))
        return relu(residual + value)

class model.ResNetBottleneckProjectionBlock
    Conv2D conv1
    BatchNorm norm1
    Conv2D conv2
    BatchNorm norm2
    Conv2D conv3
    BatchNorm norm3
    Conv2D shortcut
    BatchNorm shortcut_norm

    model.ResNetBottleneckProjectionBlock | error construct(
        int channels_in,
        int bottleneck,
        int channels_out,
        int stride,
        int seed = 1
    )
        // Original ResNet-v1 places the stage-changing stride in the first
        // 1x1 bottleneck convolution (not the later "v1.5" 3x3 placement).
        conv1 = try normal_conv2d(
            channels_in, bottleneck, 1,
            math.sqrt(2.0 / float(channels_in)),
            stride = stride, seed = seed
        )
        norm1 = try BatchNorm(bottleneck)
        conv2 = try normal_conv2d(
            bottleneck, bottleneck, 3,
            math.sqrt(2.0 / float(bottleneck * 9)),
            padding = 1, seed = seed + 1
        )
        norm2 = try BatchNorm(bottleneck)
        conv3 = try normal_conv2d(
            bottleneck, channels_out, 1,
            math.sqrt(2.0 / float(bottleneck)),
            seed = seed + 2
        )
        norm3 = try BatchNorm(channels_out)
        shortcut = try normal_conv2d(
            channels_in, channels_out, 1,
            math.sqrt(2.0 / float(channels_in)),
            stride = stride, seed = seed + 3
        )
        shortcut_norm = try BatchNorm(channels_out)

    tensor<float32> forward(tensor<float32> value)
        tensor<float32> residual = relu(norm1.forward(conv1.forward(value)))
        residual = relu(norm2.forward(conv2.forward(residual)))
        residual = norm3.forward(conv3.forward(residual))
        tensor<float32> identity = shortcut_norm.forward(shortcut.forward(value))
        return relu(residual + identity)

    tensor<float32> infer(tensor<float32> value)
        tensor<float32> residual = relu(norm1.infer(conv1.forward(value)))
        residual = relu(norm2.infer(conv2.forward(residual)))
        residual = norm3.infer(conv3.forward(residual))
        tensor<float32> identity = shortcut_norm.infer(shortcut.forward(value))
        return relu(residual + identity)

class model.ResNetBasicIdentityStage
    model.ResNetBasicBlock[] blocks

    model.ResNetBasicIdentityStage | error construct(
        int channels,
        int count,
        int seed = 1
    )
        if count <= 0
            return error("ResNet basic identity stage requires a positive block count")
        blocks = []
        for index in range(count)
            blocks = blocks.append(
                try model.ResNetBasicBlock(channels, seed + index * 2)
            )

    tensor<float32> forward(tensor<float32> value)
        tensor<float32> output = value
        for block in blocks
            output = block.forward(output)
        return output

    tensor<float32> infer(tensor<float32> value)
        tensor<float32> output = value
        for block in blocks
            output = block.infer(output)
        return output



class model.ResNetBasicOptionABlock
    Conv2D conv1
    BatchNorm norm1
    Conv2D conv2
    BatchNorm norm2
    int output_channels
    int shortcut_stride

    model.ResNetBasicOptionABlock | error construct(
        int channels_in,
        int channels_out,
        int stride,
        int seed = 1
    )
        conv1 = try normal_conv2d(
            channels_in, channels_out, 3,
            math.sqrt(2.0 / float(channels_in * 9)),
            stride = stride, padding = 1, seed = seed
        )
        norm1 = try BatchNorm(channels_out)
        conv2 = try normal_conv2d(
            channels_out, channels_out, 3,
            math.sqrt(2.0 / float(channels_out * 9)),
            padding = 1, seed = seed + 1
        )
        norm2 = try BatchNorm(channels_out)
        output_channels = channels_out
        shortcut_stride = stride

    tensor<float32> forward(tensor<float32> value)
        tensor<float32> residual = relu(
            norm1.forward(conv1.forward(value))
        )
        residual = norm2.forward(conv2.forward(residual))
        tensor<float32> identity = internal.resnet_option_a_shortcut(
            value, output_channels, shortcut_stride
        )
        return relu(residual + identity)

    tensor<float32> infer(tensor<float32> value)
        tensor<float32> residual = relu(
            norm1.infer(conv1.forward(value))
        )
        residual = norm2.infer(conv2.forward(residual))
        tensor<float32> identity = internal.resnet_option_a_shortcut(
            value, output_channels, shortcut_stride
        )
        return relu(residual + identity)

class model.ResNetBasicOptionAStage
    model.ResNetBasicOptionABlock first
    model.ResNetBasicBlock[] blocks

    model.ResNetBasicOptionAStage | error construct(
        int channels_in,
        int channels_out,
        int count,
        int seed = 1
    )
        if count <= 0
            return error("ResNet basic option-A stage requires a positive block count")
        first = try model.ResNetBasicOptionABlock(
            channels_in, channels_out, 2, seed
        )
        blocks = []
        for index in range(count - 1)
            blocks = blocks.append(
                try model.ResNetBasicBlock(
                    channels_out, seed + 2 + index * 2
                )
            )

    tensor<float32> forward(tensor<float32> value)
        tensor<float32> output = first.forward(value)
        for block in blocks
            output = block.forward(output)
        return output

    tensor<float32> infer(tensor<float32> value)
        tensor<float32> output = first.infer(value)
        for block in blocks
            output = block.infer(output)
        return output

class model.ResNetBottleneckStage
    model.ResNetBottleneckProjectionBlock first
    model.ResNetBottleneckBlock[] blocks

    model.ResNetBottleneckStage | error construct(
        int channels_in,
        int bottleneck,
        int channels_out,
        int count,
        int stride,
        int seed = 1
    )
        if count <= 0
            return error("ResNet bottleneck stage requires a positive block count")
        first = try model.ResNetBottleneckProjectionBlock(
            channels_in, bottleneck, channels_out, stride, seed
        )
        blocks = []
        for index in range(count - 1)
            blocks = blocks.append(
                try model.ResNetBottleneckBlock(
                    channels_out, bottleneck, seed + 4 + index * 3
                )
            )

    tensor<float32> forward(tensor<float32> value)
        tensor<float32> output = first.forward(value)
        for block in blocks
            output = block.forward(output)
        return output

    tensor<float32> infer(tensor<float32> value)
        tensor<float32> output = first.infer(value)
        for block in blocks
            output = block.infer(output)
        return output

class model.ResNet18
    model.ResNetStem stem
    model.ResNetBasicIdentityStage conv2_x
    model.ResNetBasicOptionAStage conv3_x
    model.ResNetBasicOptionAStage conv4_x
    model.ResNetBasicOptionAStage conv5_x
    FC fc

    model.ResNet18 | error construct(int seed = 1)
        stem = try model.ResNetStem(seed)
        conv2_x = try model.ResNetBasicIdentityStage(64, 2, seed + 10)
        conv3_x = try model.ResNetBasicOptionAStage(64, 128, 2, seed + 30)
        conv4_x = try model.ResNetBasicOptionAStage(128, 256, 2, seed + 60)
        conv5_x = try model.ResNetBasicOptionAStage(256, 512, 2, seed + 100)
        fc = try normal_fc(
            512, 1000, math.sqrt(2.0 / 512.0),
            seed = seed + 140
        )

    tensor<float32> forward(tensor<float32> value)
        internal.require_imagenet_input(value, 224)
        tensor<float32> output = stem.forward(value)
        output = conv2_x.forward(output)
        output = conv3_x.forward(output)
        output = conv4_x.forward(output)
        output = conv5_x.forward(output)
        return fc.forward(global_average_pool2d(output))

    tensor<float32> infer(tensor<float32> value)
        internal.require_imagenet_input(value, 224)
        tensor<float32> output = stem.infer(value)
        output = conv2_x.infer(output)
        output = conv3_x.infer(output)
        output = conv4_x.infer(output)
        output = conv5_x.infer(output)
        return fc.forward(global_average_pool2d(output))

    tensor<float32> probabilities(tensor<float32> value)
        return softmax(infer(value))

