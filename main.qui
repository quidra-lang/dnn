class model.VGGBlock4
    nn.Conv2D conv1
    nn.Conv2D conv2
    nn.Conv2D conv3
    nn.Conv2D conv4

    model.VGGBlock4 | error construct(int channels_in, int channels_out, int seed = 1)
        conv1 = try nn.normal_conv2d(
            channels_in, channels_out, 3, try math.sqrt(real64(0.01)),
            padding = 1, seed = seed + 0
        )
        conv2 = try nn.normal_conv2d(
            channels_out, channels_out, 3, try math.sqrt(real64(0.01)),
            padding = 1, seed = seed + 1
        )
        conv3 = try nn.normal_conv2d(
            channels_out, channels_out, 3, try math.sqrt(real64(0.01)),
            padding = 1, seed = seed + 2
        )
        conv4 = try nn.normal_conv2d(
            channels_out, channels_out, 3, try math.sqrt(real64(0.01)),
            padding = 1, seed = seed + 3
        )

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> output = value
        output = nn.relu(conv1.forward(output))
        output = nn.relu(conv2.forward(output))
        output = nn.relu(conv3.forward(output))
        output = nn.relu(conv4.forward(output))
        return output

class model.VGGA
    model.VGGBlock1 block1
    model.VGGBlock1 block2
    model.VGGBlock2 block3
    model.VGGBlock2 block4
    model.VGGBlock2 block5
    model.ImageNetFC4096 classifier

    model.VGGA | error construct(int seed = 1)
        block1 = try model.VGGBlock1(3, 64, seed + 0)
        block2 = try model.VGGBlock1(64, 128, seed + 1)
        block3 = try model.VGGBlock2(128, 256, seed + 2)
        block4 = try model.VGGBlock2(256, 512, seed + 4)
        block5 = try model.VGGBlock2(512, 512, seed + 6)
        classifier = try model.ImageNetFC4096(
            25088, seed + 8,
            weight_standard_deviation = try math.sqrt(real64(0.01)),
            hidden_bias = 0.0
        )

    private tensor<real32> features(tensor<real32> value)
        internal.require_imagenet_input(value, 224)
        tensor<real32> output = block1.forward(value)
        output = nn.max_pool2d(output, 2, 2)
        output = block2.forward(output)
        output = nn.max_pool2d(output, 2, 2)
        output = block3.forward(output)
        output = nn.max_pool2d(output, 2, 2)
        output = block4.forward(output)
        output = nn.max_pool2d(output, 2, 2)
        output = block5.forward(output)
        output = nn.max_pool2d(output, 2, 2)
        return output.reshape([value.shape()[0], 25088])

    tensor<real32> forward(tensor<real32> value)
        return classifier.forward(features(value))

    tensor<real32> infer(tensor<real32> value)
        return classifier.infer(features(value))

    tensor<real32> probabilities(tensor<real32> value)
        return nn.softmax(infer(value))

