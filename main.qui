import nn
import math
import internal = "./internal.qui"

// DNN is the architecture layer above the generic NN package.
// Reusable layers, activations, losses, optimizers, persistence, distributed
// training, native kernels, and compiler fusion policy are owned by NN.

class model.ImageNetFC4096
    nn.FC fc1
    nn.FC fc2
    nn.FC fc3
    nn.Dropout dropout1
    nn.Dropout dropout2

    model.ImageNetFC4096 | error construct(
        int features_in,
        int seed = 1,
        real64 weight_standard_deviation = 0.01,
        real64 hidden_bias = 0.0
    )
        fc1 = try nn.normal_fc(
            features_in, 4096, weight_standard_deviation,
            bias_value = hidden_bias, seed = seed
        )
        fc2 = try nn.normal_fc(
            4096, 4096, weight_standard_deviation,
            bias_value = hidden_bias, seed = seed + 1
        )
        fc3 = try nn.normal_fc(
            4096, 1000, weight_standard_deviation,
            bias_value = 0.0, seed = seed + 2
        )
        dropout1 = try nn.Dropout(0.5, seed + 3, inverted = false)
        dropout2 = try nn.Dropout(0.5, seed + 4, inverted = false)

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> output = dropout1.forward(nn.relu(fc1.forward(value)))
        output = dropout2.forward(nn.relu(fc2.forward(output)))
        return fc3.forward(output)

    tensor<real32> infer(tensor<real32> value)
        tensor<real32> output = dropout1.infer(nn.relu(fc1.forward(value)))
        output = dropout2.infer(nn.relu(fc2.forward(output)))
        return fc3.forward(output)

class model.AlexNet
    nn.Conv2D conv1
    nn.Conv2D conv2
    nn.Conv2D conv3
    nn.Conv2D conv4
    nn.Conv2D conv5
    model.ImageNetFC4096 classifier

    model.AlexNet | error construct(int seed = 1)
        conv1 = try nn.normal_conv2d(
            3, 96, 11, 0.01,
            bias_value = 0.0, stride = 4, padding = 2, seed = seed
        )
        conv2 = try nn.normal_conv2d(
            96, 256, 5, 0.01,
            bias_value = 1.0, padding = 2, seed = seed + 1, groups = 2
        )
        conv3 = try nn.normal_conv2d(
            256, 384, 3, 0.01,
            bias_value = 0.0, padding = 1, seed = seed + 2
        )
        conv4 = try nn.normal_conv2d(
            384, 384, 3, 0.01,
            bias_value = 1.0, padding = 1, seed = seed + 3, groups = 2
        )
        conv5 = try nn.normal_conv2d(
            384, 256, 3, 0.01,
            bias_value = 1.0, padding = 1, seed = seed + 4, groups = 2
        )
        classifier = try model.ImageNetFC4096(
            9216, seed + 5,
            weight_standard_deviation = 0.01,
            hidden_bias = 1.0
        )

    private tensor<real32> features(tensor<real32> value)
        // The paper explicitly trains on 224x224 crops. A two-pixel border
        // preserves its published 55->27->13->6 spatial sequence and the
        // 6x6x256 = 9216 inputs of the first fully-connected layer.
        internal.require_imagenet_input(value, 224)
        tensor<real32> output = nn.relu(conv1.forward(value))
        output = nn.local_response_normalization(output, size = 5, alpha = 0.0001, beta = 0.75, k = 2.0)
        output = nn.max_pool2d(output, 3, 2)
        output = nn.relu(conv2.forward(output))
        output = nn.local_response_normalization(output, size = 5, alpha = 0.0001, beta = 0.75, k = 2.0)
        output = nn.max_pool2d(output, 3, 2)
        output = nn.relu(conv3.forward(output))
        output = nn.relu(conv4.forward(output))
        output = nn.relu(conv5.forward(output))
        output = nn.max_pool2d(output, 3, 2)
        return output.reshape([value.shape()[0], 9216])

    tensor<real32> forward(tensor<real32> value)
        return classifier.forward(features(value))

    tensor<real32> infer(tensor<real32> value)
        return classifier.infer(features(value))

    tensor<real32> probabilities(tensor<real32> value)
        return nn.softmax(infer(value))

class model.VGGBlock1
    nn.Conv2D conv1

    model.VGGBlock1 | error construct(int channels_in, int channels_out, int seed = 1)
        conv1 = try nn.normal_conv2d(
            channels_in, channels_out, 3, try math.sqrt(real64(0.01)),
            padding = 1, seed = seed + 0
        )

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> output = value
        output = nn.relu(conv1.forward(output))
        return output

class model.VGGBlock2
    nn.Conv2D conv1
    nn.Conv2D conv2

    model.VGGBlock2 | error construct(int channels_in, int channels_out, int seed = 1)
        conv1 = try nn.normal_conv2d(
            channels_in, channels_out, 3, try math.sqrt(real64(0.01)),
            padding = 1, seed = seed + 0
        )
        conv2 = try nn.normal_conv2d(
            channels_out, channels_out, 3, try math.sqrt(real64(0.01)),
            padding = 1, seed = seed + 1
        )

    tensor<real32> forward(tensor<real32> value)
        tensor<real32> output = value
        output = nn.relu(conv1.forward(output))
        output = nn.relu(conv2.forward(output))
        return output

