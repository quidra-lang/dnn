class model.VGG16
    model.VGGD network

    model.VGG16 | error construct(int seed = 1)
        network = try model.VGGD(seed)

    void initialize_from(model.VGG11 source)
        network.initialize_from(source.network)

    tensor<real32> forward(tensor<real32> value)
        return network.forward(value)

    tensor<real32> infer(tensor<real32> value)
        return network.infer(value)

    tensor<real32> probabilities(tensor<real32> value)
        return network.probabilities(value)

