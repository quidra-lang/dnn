// Private implementation helpers for dnn.main.qui.
// This module is imported without `public`, so these functions are not part
// of the source-visible dnn package API.

void | error write_state_tensor<T: floating>(file.Handle &output, tensor<T> value)
    tensor<T> raw = value
    if raw.is_tracked()
        raw = raw.untrack()
    int[] shape = raw.shape()
    try output.write_line(len(shape).string())
    int count = 1
    for dimension in shape
        try output.write_line(dimension.string())
        count = count * dimension
    tensor<T> flat = raw.contiguous().reshape([count])
    try output.write_line(count.string())
    for index in range(count)
        try output.write_line(flat[index].item().string())
    return

tensor<float32> | error read_state_tensor32(file.Handle &input)
    string | none | error rank_line = input.read_line()
    string rank_text
    match rank_line
        string
            rank_text = rank_line
        none
            return error("dnn.load encountered unexpected end of state file")
        error problem
            return problem
    int rank = try int.parse(rank_text)
    if rank < 0
        return error("dnn.load encountered an invalid tensor rank")
    int[] shape = []
    int expected_count = 1
    for axis in range(rank)
        string | none | error dimension_line = input.read_line()
        string dimension_text
        match dimension_line
            string
                dimension_text = dimension_line
            none
                return error("dnn.load encountered unexpected end of state file")
            error problem
                return problem
        int dimension = try int.parse(dimension_text)
        if dimension < 0
            return error("dnn.load encountered an invalid tensor shape")
        shape = shape.append(dimension)
        expected_count = expected_count * dimension

    string | none | error count_line = input.read_line()
    string count_text
    match count_line
        string
            count_text = count_line
        none
            return error("dnn.load encountered unexpected end of state file")
        error problem
            return problem
    int count = try int.parse(count_text)
    if count != expected_count
        return error("dnn.load tensor element count does not match its shape")

    tensor<float32> value = tensor.zeros<float32>(shape)
    tensor<float32> flat = value.reshape([count])
    for index in range(count)
        string | none | error value_line = input.read_line()
        string value_text
        match value_line
            string
                value_text = value_line
            none
                return error("dnn.load encountered unexpected end of state file")
            error problem
                return problem
        flat[index] = try float32.parse(value_text)
    return flat.reshape(shape)

tensor<float> | error read_state_tensor64(file.Handle &input)
    string | none | error rank_line = input.read_line()
    string rank_text
    match rank_line
        string
            rank_text = rank_line
        none
            return error("dnn.load encountered unexpected end of state file")
        error problem
            return problem
    int rank = try int.parse(rank_text)
    if rank < 0
        return error("dnn.load encountered an invalid tensor rank")
    int[] shape = []
    int expected_count = 1
    for axis in range(rank)
        string | none | error dimension_line = input.read_line()
        string dimension_text
        match dimension_line
            string
                dimension_text = dimension_line
            none
                return error("dnn.load encountered unexpected end of state file")
            error problem
                return problem
        int dimension = try int.parse(dimension_text)
        if dimension < 0
            return error("dnn.load encountered an invalid tensor shape")
        shape = shape.append(dimension)
        expected_count = expected_count * dimension

    string | none | error count_line = input.read_line()
    string count_text
    match count_line
        string
            count_text = count_line
        none
            return error("dnn.load encountered unexpected end of state file")
        error problem
            return problem
    int count = try int.parse(count_text)
    if count != expected_count
        return error("dnn.load tensor element count does not match its shape")

    tensor<float> value = tensor.zeros<float>(shape)
    tensor<float> flat = value.reshape([count])
    for index in range(count)
        string | none | error value_line = input.read_line()
        string value_text
        match value_line
            string
                value_text = value_line
            none
                return error("dnn.load encountered unexpected end of state file")
            error problem
                return problem
        flat[index] = try float.parse(value_text)
    return flat.reshape(shape)

void require_imagenet_input(tensor<float32> value, int spatial)
    int[] shape = value.shape()
    if len(shape) != 4
        error("ImageNet reference models require NCHW rank-4 input")
    if shape[0] <= 0 or shape[1] != 3
        error("ImageNet reference models require a positive batch and exactly 3 RGB channels")
    if shape[2] != spatial or shape[3] != spatial
        error("ImageNet reference model input spatial size does not match the original architecture")

tensor<float32> resnet_option_a_shortcut(
    tensor<float32> value,
    int channels_out,
    int stride
)
    int[] shape = value.shape()
    if len(shape) != 4
        error("ResNet option-A shortcut requires NCHW rank-4 input")
    if stride != 1 and stride != 2
        error("ResNet option-A shortcut supports stride 1 or 2")
    int batches = shape[0]
    int channels_in = shape[1]
    int height = shape[2]
    int width = shape[3]
    if channels_out < channels_in
        error("ResNet option-A shortcut cannot reduce channel count")
    int output_height = (height - 1) / stride + 1
    int output_width = (width - 1) / stride + 1
    int count = batches * channels_in * output_height * output_width
    int[] source_indices = array(count, fill = 0)
    int[] destination_indices = array(count, fill = 0)
    for flat_index in range(count)
        int output_x = flat_index % output_width
        int remaining = flat_index / output_width
        int output_y = remaining % output_height
        remaining = remaining / output_height
        int channel = remaining % channels_in
        int batch = remaining / channels_in
        int source_y = output_y * stride
        int source_x = output_x * stride
        source_indices[flat_index] = (
            ((batch * channels_in + channel) * height + source_y)
            * width + source_x
        )
        destination_indices[flat_index] = (
            ((batch * channels_out + channel) * output_height + output_y)
            * output_width + output_x
        )
    tensor<float32> sampled = value.gather(
        source_indices,
        [batches, channels_in, output_height, output_width]
    )
    return sampled.scatter(
        destination_indices,
        [batches, channels_out, output_height, output_width]
    )
