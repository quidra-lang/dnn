// Private DNN model/architecture helpers. Generic NN helpers live in the NN package.

void require_imagenet_input(tensor<real32> value, int spatial)
    shape := int(value.shape())
    if #shape != 4
        error("ImageNet reference models require NCHW rank-4 input", code = "DNN_SHAPE")
    if shape[0] <= 0 or shape[1] != 3
        error("ImageNet reference models require a positive batch and exactly 3 RGB channels", code = "DNN_SHAPE")
    if shape[2] != spatial or shape[3] != spatial
        error("ImageNet reference model input spatial size does not match the original architecture", code = "DNN_SHAPE")

tensor<real32> resnet_option_a_shortcut(
    tensor<real32> value,
    int channels_out,
    int stride
)
    shape := int(value.shape())
    if #shape != 4
        error("ResNet option-A shortcut requires NCHW rank-4 input", code = "DNN_SHAPE")
    if stride != 1 and stride != 2
        error("ResNet option-A shortcut supports stride 1 or 2", code = "DNN_ARGUMENT")
    batches := shape[0]
    channels_in := shape[1]
    height := shape[2]
    width := shape[3]
    if channels_out < channels_in
        error("ResNet option-A shortcut cannot reduce channel count", code = "DNN_SHAPE")
    output_height := (height - 1) / stride + 1
    output_width := (width - 1) / stride + 1
    count := batches * channels_in * output_height * output_width
    source_indices := array(nat(count), fill = 0)
    destination_indices := array(nat(count), fill = 0)
    for: 0 <= int flat_index < count
        output_x := flat_index % output_width
        remaining := flat_index / output_width
        output_y := remaining % output_height
        remaining = remaining / output_height
        channel := remaining % channels_in
        batch := remaining / channels_in
        source_y := output_y * stride
        source_x := output_x * stride
        source_indices[flat_index] = (
            ((batch * channels_in + channel) * height + source_y)
            * width + source_x
        )
        destination_indices[flat_index] = (
            ((batch * channels_out + channel) * output_height + output_y)
            * output_width + output_x
        )
    sampled := value.gather(
        source_indices,
        [batches, channels_in, output_height, output_width]
    )
    return sampled.scatter(
        destination_indices,
        [batches, channels_out, output_height, output_width]
    )
