// Private DNN model/architecture helpers. Generic NN helpers live in the NN package.

void require_imagenet_input(tensor<float32> value, int spatial)
    int[] shape = value.shape()
    if len(shape) != 4
        error("ImageNet reference models require NCHW rank-4 input")
    if shape[0] <= 0 or shape[1] != 3
        error("ImageNet reference models require a positive batch and exactly 3 RGB channels")
    if shape[2] != spatial or shape[3] != spatial
        error("ImageNet reference model input spatial size does not match the original architecture")

tensor<float32> resnet_option_a_shortcut(
    tensor<float32> value,
    int channels_out,
    int stride
)
    int[] shape = value.shape()
    if len(shape) != 4
        error("ResNet option-A shortcut requires NCHW rank-4 input")
    if stride != 1 and stride != 2
        error("ResNet option-A shortcut supports stride 1 or 2")
    int batches = shape[0]
    int channels_in = shape[1]
    int height = shape[2]
    int width = shape[3]
    if channels_out < channels_in
        error("ResNet option-A shortcut cannot reduce channel count")
    int output_height = (height - 1) / stride + 1
    int output_width = (width - 1) / stride + 1
    int count = batches * channels_in * output_height * output_width
    int[] source_indices = array(count, fill = 0)
    int[] destination_indices = array(count, fill = 0)
    for flat_index in range(count)
        int output_x = flat_index % output_width
        int remaining = flat_index / output_width
        int output_y = remaining % output_height
        remaining = remaining / output_height
        int channel = remaining % channels_in
        int batch = remaining / channels_in
        int source_y = output_y * stride
        int source_x = output_x * stride
        source_indices[flat_index] = (
            ((batch * channels_in + channel) * height + source_y)
            * width + source_x
        )
        destination_indices[flat_index] = (
            ((batch * channels_out + channel) * output_height + output_y)
            * output_width + output_x
        )
    tensor<float32> sampled = value.gather(
        source_indices,
        [batches, channels_in, output_height, output_width]
    )
    return sampled.scatter(
        destination_indices,
        [batches, channels_out, output_height, output_width]
    )
